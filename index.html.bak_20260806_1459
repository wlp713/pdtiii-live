// ---- 停滞分级告警 v5.18: 追踪每条主要线 actual 最后变化时刻 → 停滞时长 + 分级 ----
//   时长依据: 前端记录 actual 每次变化的时间戳(localStorage 持久化, 刷新不丢),
//   停滞时长 = now - 最后变化时刻。分级: <15min 黄 / 15-30min 橙 / >=30min 红(闪烁)
const STALL_START_KEY = "pdtiii_stall_start_v1";
const STALL_LAST_KEY = "pdtiii_stall_last_v1";
let stallStartMap = {};
let lastActualMap = {};
try { stallStartMap = JSON.parse(localStorage.getItem(STALL_START_KEY) || "{}") || {}; } catch (e) { stallStartMap = {}; }
try { lastActualMap = JSON.parse(localStorage.getItem(STALL_LAST_KEY) || "{}") || {}; } catch (e) { lastActualMap = {}; }
function stallMinutesOf(l) {
  const ts = stallStartMap[normName(l.name)];
  if (!ts) return 0;
  return Math.max(0, Math.floor((Date.now() - ts) / 60000));
}
function stallLevelOf(l) {
  if (!isStalled(l)) return 0;
  const m = stallMinutesOf(l);
  if (m >= 30) return 3;
  if (m >= 15) return 2;
  return 1;
}
function stallTimeHtml(l) {
  const lv = stallLevelOf(l);
  if (!lv) return "";
  return `<span class="stall-time lv${lv}">${stallMinutesOf(l)}m</span>`;
}
// ★ 每次 refresh 数据到位后调用: 更新 actual 最后变化时间戳(localStorage 持久化, 刷新不丢)
//   actual 变化 >=0.5 → 记为新起点; 未变 → 沿用旧时间戳, 停滞时长持续累积
function trackStallStart() {
  const nowTs = Date.now();
  let changed = false;
  state.lines.forEach(l => {
    const k = normName(l.name);
    if (!MAIN_SET.has(k)) return;  // ★ 只追踪主要线体
    const a = Number(l.actual) || 0;
    const prev = lastActualMap[k];
    if (prev === undefined || Math.abs(a - prev) >= 0.5) {
      lastActualMap[k] = a;
      stallStartMap[k] = nowTs;
      changed = true;
    }
  });
  // 清理已消失的线(只清 lastActual, 时间戳保留避免误判)
  Object.keys(lastActualMap).forEach(k => {
    if (!state.lines.some(l => normName(l.name) === k)) delete lastActualMap[k];
  });
  if (changed) {
    try {
      localStorage.setItem(STALL_START_KEY, JSON.stringify(stallStartMap));
      localStorage.setItem(STALL_LAST_KEY, JSON.stringify(lastActualMap));
    } catch (e) { /* ignore */ }
  }
}

// ---- 历史统计 v5.18: 每日快照(localStorage) → 周/月对比 + 站擂排名 ----
//   每天每次 refresh 更新当天记录(覆盖); 跨天后保留 → 自然形成历史
//   记录字段(每条主要线): rate=达成率% eff, uph, upph=UPPH达成率%
const HIST_KEY = "pdtiii_hist_v1";
let histStore = {};
try { histStore = JSON.parse(localStorage.getItem(HIST_KEY) || "{}") || {}; } catch (e) { histStore = {}; }
function todayKey() {
  const d = new Date();
  return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
}
function dayKeyOf(d) { return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0"); }
function recordToday() {
  const now = new Date();
  const k = todayKey();
  const rec = {};
  state.lines.forEach(l => {
    const nk = normName(l.name);
    if (!MAIN_SET.has(nk)) return;
    const uph = uphOf(l, now);
    const upph = upphRateOf(l, now);
    rec[nk] = {
      rate: (l.eff !== null && !isNaN(l.eff)) ? l.eff : null,
      uph: uph == null ? null : Number(uph.toFixed(2)),
      upph: upph == null ? null : Number(upph.toFixed(1)),
      ts: Date.now()
    };
  });
  histStore[k] = rec;
  try { localStorage.setItem(HIST_KEY, JSON.stringify(histStore)); } catch (e) { /* ignore */ }
}
// 综合得分: 达成率(0-100)、UPPH达成率(%) 两指标平均; 缺任一用另一个; 全缺 null
function compScore(rec) {
  if (!rec) return null;
  const vals = [rec.rate, rec.upph].filter(v => v != null && !isNaN(v));
  if (!vals.length) return null;
  return vals.reduce((s, v) => s + v, 0) / vals.length;
}
// 一天内各线排名: 返回 { name: rank(1=第一) }, 按 compScore 降序; 同分按 uph 次排
function rankOfDay(dayRec) {
  const entries = Object.entries(dayRec || {}).map(([k, r]) => ({ k, score: compScore(r), r }));
  entries.sort((a, b) => (b.score || -Infinity) - (a.score || -Infinity) ||
    ((b.r.uph || -Infinity) - (a.r.uph || -Infinity)));
  const map = {};
  entries.forEach((e, i) => { map[e.k] = i + 1; });
  return map;
}
// 汇总 N 天: 平均 rate/upph/uph + 站擂次数(冠军=当天第一, 末位=当天最后且>=3条线有得分)
function aggregate(days) {
  const agg = {};
  days.forEach(dayRec => {
    if (!dayRec) return;
    const ranks = rankOfDay(dayRec);
    const scored = Object.keys(ranks).length;
    Object.entries(dayRec).forEach(([k, r]) => {
      const a = agg[k] || (agg[k] = { rate: [], uph: [], upph: [], first: 0, last: 0, days: 0 });
      if (r.rate != null) a.rate.push(r.rate);
      if (r.uph != null) a.uph.push(r.uph);
      if (r.upph != null) a.upph.push(r.upph);
      a.days++;
      if (scored >= 3) {
        if (ranks[k] === 1) a.first++;
        if (ranks[k] === scored) a.last++;
      }
    });
  });
  const out = {};
  Object.entries(agg).forEach(([k, a]) => {
    const avg = arr => arr.length ? arr.reduce((s, v) => s + v, 0) / arr.length : null;
    out[k] = { rate: avg(a.rate), uph: avg(a.uph), upph: avg(a.upph), first: a.first, last: a.last, days: a.days };
  });
  return out;
}
function weekStartOf(d) { const x = new Date(d); const w = (x.getDay() + 6) % 7; x.setDate(x.getDate() - w); x.setHours(0,0,0,0); return x; }
function monthStartOf(d) { return new Date(d.getFullYear(), d.getMonth(), 1); }
// 取某范围的天记录: [{key, rec}]
function rangeDays(from, to) {
  const out = [];
  for (let t = new Date(from); t <= to; t.setDate(t.getDate() + 1)) {
    const k = dayKeyOf(t);
    if (histStore[k]) out.push(histStore[k]);
