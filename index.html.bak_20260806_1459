];
function normName(n) { return String(n || "").toLowerCase().replace(/\s+/g, ""); }
// ★ Set 内容也过 normName, 否则带空格永远匹配不上
const FINAL_SET = new Set(["final a line", "final b line", "final c line", "final d line"].map(normName));
const MOTOR_SET = new Set(["motor h-series", "motor s-series", "motor f-series", "motor wl"].map(normName));
const MAIN_SET = new Set(MAIN_LINES.map(normName));

const state = { lines: [], updatedAt: null, hourly: {} };

function fmt(n) {
  if (n === null || n === undefined || isNaN(n)) return "-";
  return Number(n).toLocaleString("en-US");
}
function fmt1(n) {
  if (n === null || n === undefined || isNaN(n)) return "-";
  return Number(n).toFixed(1);
}
function shortName(name) {
  return String(name || "").replace(/ line$/i, "").replace(/-Series$/i, "").trim();
}
function hitEff(e) { return e !== null && e !== undefined && !isNaN(e) && e >= 90; }
function effClass(e) {
  if (e === null || e === undefined || isNaN(e)) return "";
  return e >= 90 ? "eff-ok" : "eff-bad";
}
function signClass(v) {
  if (v === null || v === undefined || isNaN(v)) return "zero";
  if (v > 0) return "pos";
  if (v < 0) return "neg";
  return "zero";
}
function isStalled(l) { return l.stalled === true || l.status === "STALLED"; }
function stHtml(l) {
  let stCls, stTxt;
  if (isStalled(l)) { stCls = "stall"; stTxt = t("stStall") + stallTimeHtml(l); }
  else if (l.status === "RUNNING" || l.status === "运行") { stCls = "run"; stTxt = t("stRun"); }
  else if (l.status === "OFF" || l.status === "-OFF") { stCls = "off"; stTxt = t("stOff"); }
  else { stCls = "err"; stTxt = l.status || t("stUnknown"); }
  return `<span class="st ${stCls}">${stTxt}</span>`;
}
function splitLines() {
  const now = new Date();
  const main = [], other = [];
  state.lines.forEach(l => (MAIN_SET.has(normName(l.name)) ? main : other).push(l));
  // ★ 按 UPH 从高到低排名; UPH 无效排最后; 同分按名称
  const byUph = (a, b) => {
    const ua = uphOf(a, now), ub = uphOf(b, now);
    const ea = (ua === null || ua === undefined || isNaN(ua)) ? -Infinity : ua;
    const eb = (ub === null || ub === undefined || isNaN(ub)) ? -Infinity : ub;
    if (eb !== ea) return eb - ea;
    return a.name.localeCompare(b.name);
  };
  main.sort(byUph);
  other.sort(byUph);
  return { main, other };
}
function lineNameCls(l) {
  if (l.eff === null || l.eff === undefined || isNaN(l.eff)) return "";
  return hitEff(l.eff) ? "hit-name" : "miss-name";
}

