}
function weekAgg(offsetWeeks) {
  const now = new Date();
  const ws = weekStartOf(now);
  ws.setDate(ws.getDate() + offsetWeeks * 7);
  const we = new Date(ws); we.setDate(we.getDate() + 6); we.setHours(23, 59, 59, 999);
  return aggregate(rangeDays(ws, we));
}
function monthAgg(offsetMonths) {
  const now = new Date();
  const ms = new Date(now.getFullYear(), now.getMonth() + offsetMonths, 1);
  const me = new Date(ms.getFullYear(), ms.getMonth() + 1, 0); me.setHours(23, 59, 59, 999);
