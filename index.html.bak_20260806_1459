<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>生产实时看板</title>
<style>
  :root {
    --bg: #0d1117;
    --panel: #161b22;
    --panel2: #1c2330;
    --border: #2d333b;
    --green: #3fb950;
    --orange: #d29922;
    --red: #f85149;
    --gray: #8b949e;
    --white: #e6edf3;
    --blue: #58a6ff;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    background: linear-gradient(160deg, #0d1117 0%, #0a0e14 100%);
    background-attachment: fixed;
    color: var(--white);
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    padding: 10px 16px;
    display: flex; flex-direction: column;
    height: 100vh; overflow: hidden;
  }
  .header {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 6px; margin-bottom: 8px; flex-shrink: 0;
  }
  .header .title-wrap { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .header h1 {
    font-size: 21px; letter-spacing: 2px; font-weight: 700;
    background: linear-gradient(90deg, #e6edf3, #58a6ff);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .period-label { font-size: 17px; color: #ffffff; font-weight: 700; letter-spacing: 0; margin-left: 12px; white-space: nowrap; }
  .header-right { display: flex; align-items: center; gap: 8px; }
  .conn-status { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: var(--gray); background: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 3px 10px; }
  .conn-status .dot { width: 8px; height: 8px; border-radius: 50%; background: #d29922; }
  .conn-status.ok .dot { background: #3fb950; box-shadow: 0 0 6px rgba(63,185,80,.6); }
  .conn-status.warn .dot { background: #d29922; }
  .conn-status.err .dot { background: #f85149; box-shadow: 0 0 6px rgba(248,81,73,.6); }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(63,185,80,.5); }
    70% { box-shadow: 0 0 0 8px rgba(63,185,80,0); }
    100% { box-shadow: 0 0 0 0 rgba(63,185,80,0); }
  }
  .btn {
    background: var(--panel2); color: var(--blue); border: 1px solid rgba(88,166,255,.35);
    border-radius: 14px; padding: 4px 12px; font-size: 12px; cursor: pointer;
    transition: background .15s; white-space: nowrap;
  }
  .btn:hover { background: rgba(88,166,255,.15); }
  .btn-sm { padding: 2px 8px; font-size: 10.5px; }
  .head-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px 14px; }
  .head-item { display: flex; align-items: center; gap: 8px; font-size: 12px; }
  .head-item .hn { flex: 1; color: var(--white); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .head-item input { width: 64px; background: var(--panel2); border: 1px solid var(--border); color: var(--white); border-radius: 6px; padding: 4px 8px; font-size: 12px; }
  .stall-banner {
    display: none; align-items: center; gap: 8px;
    background: rgba(248,81,73,.14); border: 1px solid rgba(248,81,73,.45);
    border-radius: 8px; padding: 6px 12px; margin-bottom: 8px;
    font-size: 13px; color: var(--red); font-weight: 600; flex-shrink: 0;
    animation: blink 1.5s infinite;
  }
  .stall-banner .slist { font-weight: 400; color: var(--white); }
  @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: .55; } }
  .kpis { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin-bottom: 10px; flex-shrink: 0; }
  .kpi {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 10px; padding: 4px 12px;
    box-shadow: 0 4px 14px rgba(0,0,0,.25);
    min-width: 0; display: flex; flex-direction: column; justify-content: center;
  }
  .kpi-top { display: flex; justify-content: space-between; align-items: center; gap: 6px; min-width: 0; }
  .kpi .label { font-size: 12.5px; color: var(--gray); font-weight: 700; display: flex; align-items: center; gap: 5px; white-space: nowrap; min-width: 0; }
  .kpi .value { font-size: 22px; font-weight: 700; line-height: 1.1; letter-spacing: .5px; flex-shrink: 0; }
  .kpi .sub { font-size: 11px; color: var(--gray); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kpi .value.green { color: var(--green); }
  .kpi .value.orange { color: var(--orange); }
  .kpi .value.red { color: var(--red); }
  .kpi .value.blue { color: var(--blue); }
  .main-grid {
    display: grid; grid-template-columns: 1.25fr 1fr; gap: 10px;
    flex: 1; min-height: 0;
  }
  .panel {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 10px; padding: 8px 12px;
    box-shadow: 0 4px 14px rgba(0,0,0,.25);
    display: flex; flex-direction: column; min-height: 0; min-width: 0;
  }
  .panel-head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 6px; flex-shrink: 0;
  }
  .panel h2 { font-size: 12.5px; color: var(--gray); font-weight: 700; letter-spacing: .5px; }
  .table-scroll { overflow-y: hidden; flex: 1; min-height: 0; }
  table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
  th {
    text-align: right; padding: 4px 6px; color: var(--gray);
    font-weight: 500; border-bottom: 1px solid var(--border); white-space: nowrap;
    font-size: 11px; position: sticky; top: 0; background: var(--panel); z-index: 1;
  }
  th:first-child, td:first-child { text-align: left; }
  td { text-align: right; padding: 12px 6px; border-bottom: 1px solid #21262d; font-variant-numeric: tabular-nums; }
  tr:hover td { background: var(--panel2); }
  tr.miss td { background: rgba(248,81,73,.05); }
  tr.miss:hover td { background: rgba(248,81,73,.1); }
  tr.stalled-row td { background: rgba(248,81,73,.1); }
  /* ---- 停滞分级: 黄 <15min / 橙 15-30min / 红 >=30min(闪烁) ---- */
  tr.stalled-row.lv1 td { background: rgba(210,153,34,.12); }
  tr.stalled-row.lv2 td { background: rgba(248,81,73,.18); }
  tr.stalled-row.lv3 td { background: rgba(248,81,73,.28); animation: stallRowBlink 1.2s infinite; }
  tr.stalled-row.lv1:hover td { background: rgba(210,153,34,.2); }
  tr.stalled-row.lv2:hover td { background: rgba(248,81,73,.26); }
  tr.stalled-row.lv3:hover td { background: rgba(248,81,73,.36); }
  @keyframes stallRowBlink { 0%,100% { opacity: 1; } 50% { opacity: .75; } }
  .stall-time {
    display: inline-flex; align-items: center; gap: 4px; margin-left: 6px;
    font-size: 10px; font-weight: 600; padding: 0 6px; border-radius: 8px;
    background: rgba(139,148,158,.15); color: var(--gray);
  }
  .st.stall .stall-time { margin-left: 4px; }
  .stall-time.lv1 { background: rgba(210,153,34,.18); color: var(--orange); }
  .stall-time.lv2 { background: rgba(248,81,73,.2); color: var(--red); }
  .stall-time.lv3 { background: rgba(248,81,73,.3); color: #ff7b72; animation: blink 1s infinite; }
  .line-name { font-weight: 600; color: var(--white); white-space: nowrap; }
  .rank { width: 32px; min-width: 32px; text-align: center; color: #8b949e; font-weight: 700; }
  .hit-name { color: var(--green); }
  .miss-name { color: var(--red); }
  .stall-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--red);
    display: inline-block; margin-right: 6px; vertical-align: 1px;
    animation: blink 1s infinite;
  }
  /* ---- 横向条形图列（列表×图表融合） ---- */
  td.bar-cell { padding: 3px 8px; min-width: 130px; }
  .hbar { position: relative; height: 12px; background: #1a1f27; border-radius: 6px; overflow: hidden; }
  .hbar .act {
    position: absolute; left: 0; top: 0; height: 100%;
    background: linear-gradient(90deg, #58a6ff, #79c0ff);
    border-radius: 6px; min-width: 3px;
  }
  .hbar .plan {
    position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    height: 5px; background: rgba(210,153,34,.9);
    border-radius: 3px; min-width: 2px;
  }
  .hbar .p100 { position: absolute; right: 0; top: -2px; height: 16px; border-right: 1px dashed rgba(139,148,158,.5); }
  .hbar-leg { font-size: 9.5px; color: var(--gray); margin-top: 1px; display: flex; gap: 10px; }
  .hbar-leg i { font-style: normal; }
  .hbar-leg .a::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 2px; background: var(--blue); margin-right: 3px; vertical-align: -1px; }
  .hbar-leg .p::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 2px; background: var(--orange); margin-right: 3px; vertical-align: -1px; }
  .st { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; padding: 1px 8px; border-radius: 10px; border: 1px solid transparent; }
  .st.run { background: rgba(63,185,80,.13); color: var(--green); border-color: rgba(63,185,80,.35); }
  .st.off { background: rgba(139,148,158,.12); color: var(--gray); border-color: rgba(139,148,158,.3); }
  .st.err { background: rgba(248,81,73,.13); color: var(--red); border-color: rgba(248,81,73,.35); }
  .st.stall { background: rgba(248,81,73,.16); color: var(--red); border-color: rgba(248,81,73,.5); animation: blink 1.2s infinite; }
  .eff-ok { color: var(--green); font-weight: 600; }
  .eff-bad { color: var(--red); font-weight: 600; }
  .pos { color: var(--green); }
  .neg { color: var(--red); }
  .zero { color: var(--gray); }
  /* 右侧图表: 上下叠 */
  .chart-col { display: flex; flex-direction: column; flex: 1; min-height: 0; gap: 8px; }
  .chart-box { flex: 2.2; min-height: 0; display: flex; flex-direction: column; }
  .chart-box.small { flex: 0.8; }
  .chart-box canvas { flex: 1; width: 100%; height: 0; min-height: 80px; }
  .legend { display: flex; gap: 12px; font-size: 10.5px; color: var(--gray); margin-bottom: 4px; flex-wrap: wrap; flex-shrink: 0; }
  .legend span::before {
    content: ""; display: inline-block; width: 9px; height: 9px;
    border-radius: 2px; margin-right: 5px; vertical-align: -1px;
  }
  .legend .lg-actual::before { background: var(--blue); }
  .legend .lg-plan::before { background: var(--orange); }
  .legend .lg-eff::before { background: var(--green); }
  .legend .hint { color: #6e7681; font-size: 10px; }
  .legend .seg-toggle { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; color: #8b949e; cursor: pointer; user-select: none; }
  .legend .seg-toggle input { width: 12px; height: 12px; accent-color: var(--blue); cursor: pointer; }
  /* 模态弹窗: 其他线体 */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,.65);
    display: none; align-items: center; justify-content: center; z-index: 100;
  }
  .modal-overlay.open { display: flex; }
  .modal {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 12px; width: min(900px, 94vw); max-height: 82vh;
    display: flex; flex-direction: column;
    box-shadow: 0 12px 40px rgba(0,0,0,.5);
  }
  .modal-head {
    display: flex; justify-content: space-between; align-items: center;
    padding: 11px 16px; border-bottom: 1px solid var(--border); flex-shrink: 0;
  }
  .modal-head h3 { font-size: 14px; color: var(--white); font-weight: 700; }
  .modal-close {
    background: var(--panel2); color: var(--gray); border: 1px solid var(--border);
    border-radius: 50%; width: 26px; height: 26px; cursor: pointer; font-size: 13px; line-height: 1;
  }
  .modal-close:hover { color: var(--white); border-color: #3d444d; }
  .modal-body { padding: 10px 16px 14px; overflow-y: auto; }
  .modal-lg { width: min(1500px, 97vw); }
  .hist-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; align-items: start; }
  .hist-section { min-width: 0; }
  .hist-section h4 { font-size: 13px; color: var(--white); font-weight: 700; margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hist-scroll { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .hist-table { font-size: 11.5px; width: 100%; }
  .hist-table th { background: var(--panel2); }
  .hist-table td, .hist-table th { padding: 6px 8px; }
  .hist-table tr:hover td { background: var(--panel2); }
  .hist-table .champ { color: var(--orange); font-weight: 700; }
  .hist-table .lastp { color: var(--red); font-weight: 700; }
  .vs-up { color: var(--green); font-weight: 600; }
  .vs-down { color: var(--red); font-weight: 600; }
  .vs-flat { color: var(--gray); }
  @media (max-width: 1100px) {
    .main-grid { grid-template-columns: 1fr; overflow-y: auto; }
    body { overflow-y: auto; }
    .kpis { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 700px) { .kpis { grid-template-columns: repeat(2, 1fr); } }
</style>
</head>
<body>
<div class="header">
  <div class="title-wrap">
    <h1><span data-i18n="boardTitle">生产实时看板</span> <span id="periodLabel" class="period-label"></span></h1>
  </div>
  <div class="header-right">
    <button class="btn" id="langBtn" title="Switch language">EN</button>
    <span class="conn-status" id="connStatus" data-i18n="connConnecting"><span class="dot"></span> 连接中…</span>
    <button class="btn" id="notifBtn" style="display:none" data-i18n="notifOn">🔔 开启停滞通知</button>
    <button class="btn" id="histBtn" data-i18n="histBtn">📊 历史统计</button>
  </div>
</div>

<div class="stall-banner" id="stallBanner">
  <span data-i18n="stallBanner">⚠️ 停滞线体: </span><span class="slist" id="stallList"></span>
</div>

<div class="kpis">
  <div class="kpi"><div class="kpi-top"><div class="label" data-i18n="kpiRun">🟢 运行线体</div><div class="value" id="kpiRun">-</div></div><div class="sub" id="kpiRunSub" data-i18n="kpiRunSub">主要 8 条</div></div>
  <div class="kpi"><div class="kpi-top"><div class="label" data-i18n="kpiEff">⚡ 平均效率</div><div class="value" id="kpiEff">-</div></div><div class="sub" data-i18n="kpiEffSub">主要线体加权</div></div>
  <div class="kpi"><div class="kpi-top"><div class="label" data-i18n="kpiHit">🏆 达成线体 ≥90%</div><div class="value" id="kpiHit">-</div></div><div class="sub" id="kpiHitSub" data-i18n="kpiHitSub">达成线体</div></div>
  <div class="kpi"><div class="kpi-top"><div class="label" data-i18n="kpiFinal">🔵 Final 产量</div><div class="value blue" id="kpiFinal">-</div></div><div class="sub" data-i18n="kpiFinalSub">Final A-D 合计</div></div>
  <div class="kpi"><div class="kpi-top"><div class="label" data-i18n="kpiMotor">🟠 Motor 产量</div><div class="value orange" id="kpiMotor">-</div></div><div class="sub" data-i18n="kpiMotorSub">Motor H/S/F/WL 合计</div></div>
</div>

<div class="main-grid">
  <div class="panel">
    <div class="panel-head">
      <h2 data-i18n="panelMainTitle">📋 主要线体 · 产量对比 · 按 UPH 排序</h2>
      <button class="btn" id="otherBtn" data-i18n="otherLines">其他线体 (0)</button>
    </div>
    <div class="table-scroll">
      <table id="mainTable">
        <thead>
          <tr>
            <th>#</th><th data-i18n="thLine">线体</th><th data-i18n="thOutput">产量 (蓝=实际 · 橙=计划)</th>
            <th>Actual</th><th>Plan</th><th data-i18n="thDiff">差异</th><th data-i18n="thRate">达成率%</th><th>UPH</th><th data-i18n="thStatus">状态</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
  <div class="panel">
    <div class="panel-head"><h2 data-i18n="panelChartTitle">📊 每小时产量 / 效率 (主要线体)</h2></div>
    <div class="chart-col">
      <div class="chart-box">
        <div class="legend"><span class="lg-actual" data-i18n="lgActual">Actual 实际</span><span class="lg-plan" data-i18n="lgPlan">Plan 实时目标</span><label class="seg-toggle" data-i18n-title="segToggleTitle" title="勾选后每个时段实际柱与目标柱逐段对齐对比, 段内数字=该时段产量/目标"><input type="checkbox" id="segToggle"> <span data-i18n="hourlyOut">小时产出</span></label><span class="hint" data-i18n="hintSeg">两柱完全平行 · 蓝色=实际达成 · 灰色=未达成缺口</span></div>
        <canvas id="chartBar"></canvas>
      </div>
      <div class="chart-box small">
        <div class="legend"><span class="lg-eff" data-i18n="lgEff">UPPH 达成率 (效率)</span><span class="hint" data-i18n="hintUpph">UPPH = 产量÷人数÷工时</span><button class="btn btn-sm" id="headBtn" style="margin-left:auto" data-i18n="editHead">✏️ 编辑人数</button></div>
        <canvas id="chartEff"></canvas>
      </div>
    </div>
  </div>
</div>

<!-- 其他线体模态 -->
<div class="modal-overlay" id="otherModal">
  <div class="modal">
    <div class="modal-head">
      <h3 id="modalTitle" data-i18n="otherLines">其他线体</h3>
      <span class="hint" style="margin-left:10px" data-i18n="sortByUph">按 UPH 从高到低排序</span>
      <button class="modal-close" id="modalClose">✕</button>
    </div>
    <div class="modal-body">
      <table id="otherTable">
        <thead>
          <tr>
            <th>#</th><th data-i18n="thLine">线体</th><th data-i18n="thTargetDay">目标/日</th><th>Plan</th><th>Actual</th>
            <th data-i18n="thDiff">差异</th><th data-i18n="thRate">达成率%</th><th data-i18n="thStatus">状态</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<!-- 历史统计模态 -->
<div class="modal-overlay" id="histModal">
  <div class="modal modal-lg">
    <div class="modal-head">
      <h3 data-i18n="histTitle">📊 历史统计 · 周/月对比 · 站擂排名</h3>
      <button class="modal-close" id="histClose">✕</button>
    </div>
    <div class="modal-body">
      <div class="hist-grid">
      <div class="hist-section">
        <h4 data-i18n="histToday">📌 今日实时</h4>
        <div class="hist-scroll">
          <table class="hist-table" id="histTodayTbl">
            <thead><tr><th data-i18n="thLine">线体</th><th data-i18n="thRate">达成率%</th><th>UPH</th><th data-i18n="thUpphRate">UPPH达成%</th><th data-i18n="thScore">综合分</th><th data-i18n="thRank">今日排名</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
      <div class="hist-section">
        <h4 id="histWeekTitle">🗓 本周 vs 上周</h4>
        <div class="hist-scroll">
          <table class="hist-table" id="histWeekTbl">
            <thead><tr><th data-i18n="thLine">线体</th><th data-i18n="thWeekRate">周均达成%</th><th data-i18n="thWeekUpph">周均UPPH%</th><th data-i18n="thWeekVsPrev">vs 上周</th><th data-i18n="thChamp">🏆 站擂第一</th><th data-i18n="thLast">🔻 末位</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
      <div class="hist-section">
        <h4 id="histMonthTitle">📅 本月 vs 上月</h4>
        <div class="hist-scroll">
          <table class="hist-table" id="histMonthTbl">
            <thead><tr><th data-i18n="thLine">线体</th><th data-i18n="thMonthRate">月均达成%</th><th data-i18n="thMonthUpph">月均UPPH%</th><th data-i18n="thMonthVsPrev">vs 上月</th><th data-i18n="thChamp">🏆 站擂第一</th><th data-i18n="thLast">🔻 末位</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
      </div>
    </div>
  </div>
</div>

<!-- 编辑人数模态 -->
<div class="modal-overlay" id="headModal">
  <div class="modal">
    <div class="modal-head">
      <h3 data-i18n="editHeadTitle">✏️ 编辑各线出勤人数</h3>
      <button class="modal-close" id="headClose">✕</button>
    </div>
    <div class="modal-body">
      <p class="hint" style="margin:0 0 8px" data-i18n="headHint">UPPH = 产量 ÷ 人数 ÷ 已工作小时；UPPH目标(固定) = 日目标 ÷ 标准工时(10.67h) ÷ 人数。每天人数可改，保存后自动生效。</p>
      <div class="head-grid" id="headGrid"></div>
      <div style="margin-top:12px;text-align:right"><button class="btn" id="headSave" data-i18n="save">💾 保存</button></div>
    </div>
  </div>
</div>

<script>
"use strict";
