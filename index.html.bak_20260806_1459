function drawBar(main) {
  const cv = document.getElementById("chartBar");
  const dpr = window.devicePixelRatio || 1;
  const W = cv.clientWidth, H = cv.clientHeight || 230;
  if (W < 20) return;
  cv.width = W * dpr; cv.height = H * dpr;
  const ctx = cv.getContext("2d");
  ctx.scale(dpr, dpr);
  ctx.clearRect(0, 0, W, H);
  const lines = main;
  if (!lines.length) { ctx.fillStyle = "#8b949e"; ctx.font = "13px sans-serif"; ctx.fillText(t("noData"), W/2-24, H/2); return; }
  const padL = 46, padB = 34, padT = 26;
  const cw = W - padL - 12, ch = H - padT - padB;
  // ★ maxV 基于各线 plan 累计(目标柱骨架)取最大 — 两柱共用同一骨架, 柱顶=plan 累计, 完全平行
  //   (若某线 actual 超额超过 plan, 段内蓝色画满后不再延伸, 柱顶数字仍显示真实实际值)
  const nowH = new Date().getHours();
  const maxV = Math.max(1, ...lines.map(l => Math.max(l.plan || 0, l.actual || 0)));
  const step = Math.ceil(maxV / 4 / 10) * 10;
  ctx.strokeStyle = "#21262d"; ctx.fillStyle = "#8b949e"; ctx.font = "10px sans-serif";
  for (let i = 0; i <= 4; i++) {
    const y = padT + ch - (ch * i / 4);
    ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W - 8, y); ctx.stroke();
    ctx.fillText(fmt(step * i), 4, y + 3);
  }
  const n = lines.length, slot = cw / n;
  const bw = Math.min(20, slot * 0.3);
  lines.forEach((l, i) => {
    const cx = padL + slot * i + slot / 2;
    // ★ 小时产出开关: 开启后实际柱/目标柱共用同一份 segs(统一骨架) → 段边界完全一致, 逐段对比差异
    if (segShow) {
      const segs = segsOf(l.name, l.actual);
      // 实际柱(蓝): 每段画实际产量, 段内写该时段实际达成数
      drawStacked(ctx, cx - bw - 1.5, bw, segs, l.actual, maxV, ch, padT, "#58a6ff", "actual");
      // 目标柱(橙): 同一份 segs, 每段画目标产量(均匀), 段内写该时段目标数 → 与实际柱逐段对齐
      drawStacked(ctx, cx + 1.5, bw, segs, l.plan || 0, maxV, ch, padT, "#d29922", "plan");
    } else {
      // 关闭分段: 全天累计纯色柱(柱顶=累计值), 不画横线不画编号 → 上午缺数据时显示统一
      const aH = Math.max(0, (l.actual || 0) / maxV * ch);
      ctx.fillStyle = "#58a6ff";
      ctx.fillRect(cx - bw - 1.5, padT + ch - aH, bw, aH);
      const pCum = l.plan || 0;
      const pH = Math.max(0, pCum / maxV * ch);
      ctx.fillStyle = "#d29922";
      ctx.fillRect(cx + 1.5, padT + ch - pH, bw, pH);
      ctx.fillStyle = "#58a6ff"; ctx.font = "9px sans-serif"; ctx.textAlign = "center";
      if (aH > 0) ctx.fillText(fmt(l.actual), cx - bw - 1.5 + bw / 2, padT + ch - aH - 3);
      ctx.fillStyle = "#d29922";
      if (pH > 0) ctx.fillText(fmt(pCum), cx + 1.5 + bw / 2, padT + ch - pH - 3);
    }
    ctx.fillStyle = "#8b949e"; ctx.font = "10px sans-serif"; ctx.textAlign = "center";
    ctx.fillText(shortName(l.name), cx, H - 10);
  });
  ctx.textAlign = "left";
}

