function hbarHtml(l, maxV) {
  const aw = maxV > 0 ? Math.max(0, (Number(l.actual) || 0) / maxV * 100) : 0;
  const pw = maxV > 0 ? Math.max(0, (Number(l.plan) || 0) / maxV * 100) : 0;
  const stalledCls = isStalled(l) ? " style=\"border:1px solid rgba(248,81,73,.6)\"" : "";
  return `<div class="hbar"${stalledCls}><div class="p100"></div>` +
    `<div class="plan" style="width:${pw}%"></div>` +
    `<div class="act" style="width:${aw}%"></div></div>`;
}

