// 已工作小时(净工时): 8:00 上班 → 20:20 下班; 休息: 10:00-10:10(10min) + 12:00-13:00午休(1h) + 15:05-15:15(10min) + 17:00-17:20(20min)
//   封顶净工时 = (20:20-8:00=12h20m) - 100min休息 = 10h40m = 10.67h; 与 UPPH 目标分母 10.67h 口径一致
// ★ 班次判断 (按班次开始小时查名; 当前看板数据从 8:00 开始累计 → 早班; 若以后支持多班次数据, 班次开始时间变化会自动跟随)
const SHIFT_RANGES = [
  { s: 8, e: 16, key: "shiftDay" },
  { s: 16, e: 24, key: "shiftSwing" },
  { s: 0, e: 8, key: "shiftNight" }
];
function shiftNameOfHour(h) {
  for (const sh of SHIFT_RANGES) if (h >= sh.s && h < sh.e) return t(sh.key);
  return "";
}

function workedHours(now) {
  const mins = now.getHours() * 60 + now.getMinutes();
  const start = 8 * 60, end = 20 * 60 + 20;   // 8:00 上班 → 20:20 下班
  if (mins <= start) return 0;
  const mm = Math.min(mins, end);             // 产量实时累计, 封顶 20:20
  let w = mm - start;
  // 扣除休息: 上午 10:00-10:10, 午休 12:00-13:00, 下午 15:05-15:15, 17:00-17:20
  const breaks = [
    [10 * 60, 10 * 60 + 10],
    [12 * 60, 13 * 60],
    [15 * 60 + 5, 15 * 60 + 15],
    [17 * 60, 17 * 60 + 20]
  ];
  for (const [bs, be] of breaks) {
    const ov = mm - Math.max(start, bs);
    if (ov > 0) w -= Math.min(be - bs, ov);
  }
  return Math.max(0, w) / 60;
}
// UPH = 实际产量 ÷ 实际工作小时(净工时, 不含人数)
function uphOf(l, now) {
  const w = workedHours(now);
  if (!w) return null;
  return (Number(l.actual) || 0) / w;
}
function uphTxt(l, now) {
  const u = uphOf(l, now);
  return u == null ? "-" : fmt1(u);
}
// UPPH = 产量 ÷ 人数 ÷ 已工作小时
function upphOf(l, now) {
  const n = headOf(l.name);
  const w = workedHours(now);
  if (!n || !w) return null;
  return (Number(l.actual) || 0) / n / w;
}
// 当前小时累计计划产量: ★ 优先用实时累计计划(工厂实时推送, 与表格 Plan 列一致)
//   ⚠️ 2026-08-06 修复: 原逻辑只取 hourly 定格快照的 plan, 但快照在每小时首次出现时定格后不再更新
//      (如 08:10 定格 plan=42, 实时已 105) → UPPH 目标严重滞后 → 达成率虚高(169% 实为 68%)
function planNowOf(l, now) {
  const live = Number(l.plan) || 0;
  if (live > 0) return live;
  const hourly = state.hourly || {};
  const arr = hourly[l.name.trim()];
  if (!Array.isArray(arr) || !arr.length) return null;
  const h = now.getHours();
  let best = null, bestH = -1;
  for (const s of arr) {
    const sh = Number(s.h) || 0;
    if (sh <= h && sh > bestH) { best = s; bestH = sh; }
  }
  return best ? (Number(best.plan) || 0) : null;
}
// UPPH目标(固定) = 日目标 ÷ 标准工时(10.67h) ÷ 人数
//   ★ 2026-08-06 v5.18.4 修复: 原来用"实时计划 ÷ 当前工时 ÷ 人数"反推,
//     导致 UPPH达成率 ≡ 产出达成率(actual/plan), 两个维度完全重合, 综合分失去意义。
//   现在固定目标口径: 达成率 = (actual÷n÷w) ÷ (target÷n÷10.67) = actual×10.67/(target×w)
//     与产出达成率(actual/plan)相互独立 → 综合分 = 两维度平均才有意义。
//   无日目标的线 fallback: 实时计划反推(仅兜底, 不参与主要线排名)
function upphTargetOf(l, now) {
  const n = headOf(l.name);
  if (!n) return null;
  const target = Number(l.target) || 0;
  if (target > 0) return target / n / (640 / 60);
  const w = workedHours(now);
  if (!w) return null;
  const planNow = planNowOf(l, now);
  if (planNow) return planNow / w / n;
  return null;
}
// 达成率% = 当前UPPH / UPPH目标(实时) × 100
function upphRateOf(l, now) {
  const u = upphOf(l, now), t = upphTargetOf(l, now);
  if (u == null || t == null || t <= 0) return null;
  return u / t * 100;
}
function drawEff(main) {
  const cv = document.getElementById("chartEff");
  const dpr = window.devicePixelRatio || 1;
  const W = cv.clientWidth, H = cv.clientHeight || 180;
  if (W < 20) return;
  cv.width = W * dpr; cv.height = H * dpr;
  const ctx = cv.getContext("2d");
  ctx.scale(dpr, dpr);
  ctx.clearRect(0, 0, W, H);
  const lines = main;
  if (!lines.length) { ctx.fillStyle = "#8b949e"; ctx.font = "13px sans-serif"; ctx.fillText(t("noData"), W/2-24, H/2); return; }
  const padL = 40, padB = 34, padT = 22;
  const cw = W - padL - 12, ch = H - padT - padB;
  const now = new Date();
  // ★ UPPH 达成率图表: 上限 = max(120%, 最高达成率向上取整到20), 达成率低时用 120% 不会太空
  const maxRate = lines.reduce((m, l) => { const r = upphRateOf(l, now); return Math.max(m, r == null ? 0 : r); }, 0);
  const maxV = Math.max(120, Math.ceil(Math.max(maxRate, 1) / 20) * 20);
  ctx.strokeStyle = "#21262d"; ctx.fillStyle = "#8b949e"; ctx.font = "10px sans-serif";
  // 刻度: 0, 25%, 50%, 75%, 100%(上限); 100% 达成线固定
  [0, 0.25, 0.5, 0.75, 1].forEach((f, i) => {
    const v = Math.round(maxV * f);
    const y = padT + ch - (ch * v / maxV);
    ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W - 8, y); ctx.stroke();
    ctx.fillText(v + "%", 4, y + 3);
  });
  // 100% 达成线(绿色虚线)
  const y100 = padT + ch - (ch * 100 / maxV);
  ctx.strokeStyle = "rgba(63,185,80,.55)"; ctx.setLineDash([4, 3]);
  ctx.beginPath(); ctx.moveTo(padL, y100); ctx.lineTo(W - 8, y100); ctx.stroke();
  ctx.setLineDash([]);
  const n = lines.length, slot = cw / n;
  const bw = Math.min(28, slot * 0.4);
  lines.forEach((l, i) => {
    const cx = padL + slot * i + slot / 2;
    const rate = upphRateOf(l, now);
    const hasHead = headOf(l.name) > 0;
    if (rate == null || !hasHead) {
      // 未填人数: 灰色矮柱 + "填人数"提示
      ctx.fillStyle = "#3d444d";
      ctx.fillRect(cx - bw / 2, padT + ch - 4, bw, 4);
      ctx.fillStyle = "#8b949e"; ctx.font = "8px sans-serif"; ctx.textAlign = "center";
      ctx.fillText(t("setPeople"), cx, padT + ch - 7);
    } else {
      const e = Math.max(0, Math.min(rate, maxV));
      const h = ch * e / maxV;
      ctx.fillStyle = rate >= 100 ? "#3fb950" : "#f85149";
      ctx.fillRect(cx - bw / 2, padT + ch - h, bw, h);
      ctx.fillStyle = rate >= 100 ? "#3fb950" : "#f85149";
      ctx.font = "bold 9px sans-serif"; ctx.textAlign = "center";
      ctx.fillText(fmt1(rate) + "%", cx, padT + ch - h - 3);
    }
    ctx.fillStyle = "#8b949e"; ctx.font = "10px sans-serif";
    ctx.fillText(shortName(l.name), cx, H - 10);
  });
  ctx.textAlign = "left";
}

// ---- 编辑人数弹窗 ----
function openHeadModal() {
  const grid = document.getElementById("headGrid");
  grid.innerHTML = "";
  const names = [];
  state.lines.forEach(l => { if (!names.includes(l.name)) names.push(l.name); });
  names.sort();
  names.forEach(name => {
    const item = document.createElement("div");
    item.className = "head-item";
    const lab = document.createElement("span");
    lab.className = "hn"; lab.textContent = name;
    // ★ 修复: 用 name 查找对应 line 对象, 不能再引用未定义的 l
    const ln = state.lines.find(x => x.name === name) || {};
    lab.title = t("headTitleFmt").replace("{name}", name).replace("{p}", fmt(planNowOf(ln, new Date()) || 0));
    const inp = document.createElement("input");
    inp.type = "number"; inp.min = "0"; inp.step = "1";
    inp.value = headOf(name) || "";
    inp.dataset.name = name;
    item.appendChild(lab); item.appendChild(inp);
    grid.appendChild(item);
  });
  document.getElementById("headModal").classList.add("open");
}
function saveHeads() {
  document.querySelectorAll("#headGrid input").forEach(inp => {
    setHead(inp.dataset.name, inp.value);
  });
  document.getElementById("headModal").classList.remove("open");
  renderAll();
}

function renderAll() {
  const { main } = renderTable();
  renderKPIs(main);
  drawBar(main);
  drawEff(main);
  checkStalls();
}

// ★ 标题: 日期 + 班次 + 时段(精确到秒) — 由每秒 timer 刷新, 不依赖 refresh 周期
function updatePeriodLabel() {
  const pl = document.getElementById("periodLabel");
  if (!pl || pl.dataset.frozen === "1") return;
  const now = new Date();
  const hh = String(now.getHours()).padStart(2, "0");
  const mm = String(now.getMinutes()).padStart(2, "0");
  const ss = String(now.getSeconds()).padStart(2, "0");
  pl.textContent = (now.getMonth() + 1) + "/" + now.getDate() + " " + shiftNameOfHour(8) + " 8:00 - " + hh + ":" + mm + ":" + ss;
}

async function refresh() {
  const cs = document.getElementById("connStatus");
  // ★ file:// 直接打开会无法 fetch 数据(浏览器拦截) — 给出明确指引而非模糊的"连接失败"
  if (location.protocol === "file:") {
    const pl = document.getElementById("periodLabel");
    if (pl) { pl.dataset.frozen = "1"; pl.textContent = t("useHttp"); }
    if (cs) { cs.className = "conn-status err"; cs.innerHTML = "<span class='dot'></span> " + t("fileErr"); }
    return;
  }
  // ★ fetch 加 8s 超时(AbortController): 服务器卡住时不再无限等待
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 8000);
  try {
    if (cs) { cs.className = "conn-status"; cs.innerHTML = "<span class='dot'></span> " + t("connConnecting"); }
    const r = await fetch(DATA_URL + "?t=" + Date.now(), { signal: ctrl.signal });
    if (!r.ok) throw new Error("HTTP " + r.status);
    const d = await r.json();
    state.lines = d.lines || [];
    state.hourly = d.hourly || {};
    state.updatedAt = d.updatedAt || null;
    // ★ 连接状态: 按数据新鲜度判断 — updatedAt 距现在 ≤90s=已连接; ≤5min=延迟; >5min/无=断线
    //   ⚠️ data.json 的 updatedAt 是字符串 "YYYY-MM-DD HH:MM:SS", 必须先转时间戳再相减
    const st = d.source || "";
    if (cs) {
      const ts = (typeof state.updatedAt === "string")
        ? new Date(state.updatedAt.replace(" ", "T") + "+07:00").getTime()
        : (state.updatedAt || 0);
      const age = ts ? (Date.now() - ts) : Infinity;
      if (age <= 90000) { cs.className = "conn-status ok"; cs.innerHTML = "<span class='dot'></span> " + t("connOk"); }
      else if (age <= 300000) { cs.className = "conn-status warn"; cs.innerHTML = "<span class='dot'></span> " + t("connDelay").replace("{s}", Math.round(age / 1000)); }
      else { cs.className = "conn-status err"; cs.innerHTML = "<span class='dot'></span> " + (ts ? t("connDown").replace("{m}", Math.round(age / 60000)) : t("connNoData")); }
    }
    // ★ 标题: 日期 + 班次 + 时段(含秒) — 正常状态解冻并更新
    const pl = document.getElementById("periodLabel");
    if (pl) { pl.dataset.frozen = "0"; updatePeriodLabel(); }
    trackStallStart();   // ★ v5.18 停滞时长追踪(需在 renderAll 前: renderTable 要用 stallLevelOf)
    recordToday();       // ★ v5.18 历史统计: 记录今日快照(覆盖当天, 跨天保留)
    renderAll();
  } catch (e) {
    const pl = document.getElementById("periodLabel");
    if (pl) { pl.dataset.frozen = "1"; pl.textContent = t("connFailed"); }
    if (cs) { cs.className = "conn-status err"; cs.innerHTML = "<span class='dot'></span> " + t("connFailedMsg").replace("{m}", (e && e.message ? e.message : String(e))); }
  } finally {
    clearTimeout(timer);
  }
}

// ---- 历史统计面板渲染 ----
function vsHtml(cur, prev) {
  if (cur == null) return `<span class="vs-flat">-</span>`;
  if (prev == null || prev <= 0) return `<span class="vs-flat">${fmt1(cur)}%</span>`;
  const d = cur - prev;
  const cls = Math.abs(d) < 0.5 ? "vs-flat" : (d > 0 ? "vs-up" : "vs-down");
  const arrow = Math.abs(d) < 0.5 ? "→" : (d > 0 ? "↑" : "↓");
  return `<span class="${cls}">${arrow} ${fmt1(Math.abs(d))}%</span>`;
}
// 聚合记录的得分(与 compScore 同口径: rate/upph 平均)
function aggScoreOf(a) {
  if (!a) return null;
  const vals = [a.rate, a.upph].filter(v => v != null && !isNaN(v));
  return vals.length ? vals.reduce((s, v) => s + v, 0) / vals.length : null;
}
function renderHist() {
  const now = new Date();
  // --- 今日 ---
  const todayRec = histStore[todayKey()] || {};
  const todayTbody = document.querySelector("#histTodayTbl tbody");
  todayTbody.innerHTML = "";
  const ranks = rankOfDay(todayRec);
  // ★ 按排名先后顺序渲染(第1名在最上)
  const todayNames = MAIN_LINES.slice().sort((a, b) => (ranks[normName(a)] || 999) - (ranks[normName(b)] || 999));
  todayNames.forEach(name => {
    const nk = normName(name);
    const r = todayRec[nk];
    if (!r) {
      todayTbody.innerHTML += `<tr><td>${name.trim()}</td><td class="zero">-</td><td class="zero">-</td><td class="zero">-</td><td class="zero">-</td><td class="zero">-</td></tr>`;
      return;
    }
    const score = compScore(r);
    const rank = ranks[nk] || "-";
    const rankHtml = rank === 1 ? `<span class="champ">🥇 ${rank}</span>` : (rank === Object.keys(ranks).length ? `<span class="lastp">🔻 ${rank}</span>` : `${rank}`);
    todayTbody.innerHTML +=
      `<tr><td class="line-name">${name.trim()}</td>` +
      `<td class="${effClass(r.rate)}">${r.rate == null ? '-' : fmt1(r.rate)}</td>` +
      `<td>${r.uph == null ? '-' : fmt1(r.uph)}</td>` +
      `<td>${r.upph == null ? '-' : fmt1(r.upph)}</td>` +
      `<td class="${score != null && score >= 90 ? 'pos' : score != null ? '' : 'zero'}">${score == null ? '-' : fmt1(score)}</td>` +
      `<td>${rankHtml}</td></tr>`;
  });
  // --- 本周 vs 上周 ---
  const wk = weekAgg(0), pw = weekAgg(-1);
  const wkTbody = document.querySelector("#histWeekTbl tbody");
  wkTbody.innerHTML = "";
  document.getElementById("histWeekTitle").textContent =
    t("histWeekTitle") + ` (${fmt1(wkAvg(wk))}% vs ${fmt1(wkAvg(pw))}%)`;
  // ★ 按本周综合得分降序(第1名在最上)
  const wkNames = MAIN_LINES.slice().sort((a, b) => (aggScoreOf(wk[normName(b)]) ?? -1e9) - (aggScoreOf(wk[normName(a)]) ?? -1e9));
  wkNames.forEach(name => {
    const nk = normName(name);
    const a = wk[nk], p = pw[nk];
    if (!a) {
      wkTbody.innerHTML += `<tr><td>${name.trim()}</td><td class="zero">-</td><td class="zero">-</td><td class="zero">-</td><td class="zero">-</td><td class="zero">-</td></tr>`;
      return;
    }
    wkTbody.innerHTML +=
      `<tr><td class="line-name">${name.trim()}</td>` +
      `<td class="${effClass(a.rate)}">${a.rate == null ? '-' : fmt1(a.rate)}</td>` +
      `<td>${a.upph == null ? '-' : fmt1(a.upph)}</td>` +
      `<td>${vsHtml(a.rate, p ? p.rate : null)}</td>` +
      `<td class="champ">${a.first ? '🏆 ' + a.first : '-'}</td>` +
      `<td class="lastp">${a.last ? '🔻 ' + a.last : '-'}</td></tr>`;
  });
  // --- 本月 vs 上月 ---
  const mk = monthAgg(0), pm = monthAgg(-1);
  const mkTbody = document.querySelector("#histMonthTbl tbody");
  mkTbody.innerHTML = "";
  document.getElementById("histMonthTitle").textContent =
    t("histMonthTitle") + ` (${fmt1(mkAvg(mk))}% vs ${fmt1(mkAvg(pm))}%)`;
  // ★ 按本月综合得分降序(第1名在最上)
  const mkNames = MAIN_LINES.slice().sort((a, b) => (aggScoreOf(mk[normName(b)]) ?? -1e9) - (aggScoreOf(mk[normName(a)]) ?? -1e9));
  mkNames.forEach(name => {
    const nk = normName(name);
    const a = mk[nk], p = pm[nk];
    if (!a) {
      mkTbody.innerHTML += `<tr><td>${name.trim()}</td><td class="zero">-</td><td class="zero">-</td><td class="zero">-</td><td class="zero">-</td><td class="zero">-</td></tr>`;
      return;
    }
    mkTbody.innerHTML +=
      `<tr><td class="line-name">${name.trim()}</td>` +
      `<td class="${effClass(a.rate)}">${a.rate == null ? '-' : fmt1(a.rate)}</td>` +
      `<td>${a.upph == null ? '-' : fmt1(a.upph)}</td>` +
      `<td>${vsHtml(a.rate, p ? p.rate : null)}</td>` +
      `<td class="champ">${a.first ? '🏆 ' + a.first : '-'}</td>` +
      `<td class="lastp">${a.last ? '🔻 ' + a.last : '-'}</td></tr>`;
  });
}
// 聚合集平均达成率(表头摘要用)
function wkAvg(agg) {
  const vals = Object.values(agg).map(a => a.rate).filter(v => v != null);
  return vals.length ? vals.reduce((s, v) => s + v, 0) / vals.length : null;
}
function mkAvg(agg) { return wkAvg(agg); }

