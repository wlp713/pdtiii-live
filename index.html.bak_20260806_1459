// ---- 小时产量分段: 实际柱与目标柱共用同一时段骨架(逐段对齐, 直接对比每时段实际 vs 目标差异) ----
// 编号规则: 工作时间 8-17点, 12-13点午休忽略
//   8-9=1, 9-10=2, 10-11=3, 11-12=4, (12-13午休), 13-14=5, 14-15=6, 15-16=7, 16-17=8
function hourNo(lab) {
  if (lab >= 8 && lab <= 11) return lab - 7;   // 8→1, 9→2, 10→3, 11→4
  if (lab >= 13 && lab <= 16) return lab - 8;  // 13→5, 14→6, 15→7, 16→8
  return null; // 12午休 / 其他不统计
}
// ★ 统一骨架: 每段同时含 actual(该时段实际产量) 与 plan(该时段目标)
//   plan/actual 均来自 hourly 快照的定格累计值差分 → 时段一过即定格, 不再随实时数据变化
//   live 段(当前进行中的小时) = 实时累计 − 上一快照定格 → 继续累计变化
//   base 段 = 启动前累计(今天上午缺小时数据): 实际柱/目标柱都画灰底, 段内写"上午"+累计值
//   ★ 目的: 同一时段的实际段与目标段在两根柱子上位置完全一致 → 逐段比高度 = 直接看差异
function segsOf(name, curActual) {
  const snaps = (state.hourly || {})[name] || [];
  const ln = state.lines.find(x => x.name === name) || {};
  const livePlan = Number(ln.plan) || 0; // 实时累计目标(与表格 Plan 列一致, 仅 live 段用)
  if (!snaps.length) return [];
  const nowH = new Date().getHours();
  const segs = [];
  if (snaps[0].h > 8) {
    // ★ 当天中途启动(今天上午缺小时数据):
    //   base 段 = 启动前累计, 截止到第一个下午快照(h>=13) → 包含上午全部产量+午休段产量
    //   ⚠️ 必须用第一个下午快照的 actual, 不能用首条快照: 否则 h11→h13 之间(含午休)的产量会丢,
    //      实际柱累计 ≠ 表格 Actual 列(今天实测: 丢 303 件)
    //   base 段目标 = 第一个有效快照的定格累计 plan(定格, 不再变)
    let baseIdx = snaps.length - 1;
    for (let i = 0; i < snaps.length; i++) {
      if (snaps[i].h >= 13) { baseIdx = i; break; }
    }
    segs.push({
      h: snaps[baseIdx].h, lab: null, live: false, base: true,
      actual: snaps[baseIdx].actual || 0,
      plan: snaps[baseIdx].plan || 0
    });
    for (let i = baseIdx + 1; i < snaps.length; i++) {
      const prev = snaps[i - 1], s = snaps[i];
      segs.push({
        h: s.h, lab: prev.h, live: false,
        actual: Math.max(0, (s.actual || 0) - (prev.actual || 0)),
        plan: Math.max(0, (s.plan || 0) - (prev.plan || 0))
      });
    }
    // ★ 当前进行中的小时: 最新整点快照作基准 → 当前 actual 差值 = 正在累积的产量
    const last = snaps[snaps.length - 1];
    if (curActual != null && last && last.h >= 13 && last.h <= nowH && nowH - last.h < 2) {
      segs.push({
        h: nowH, lab: last.h, live: true,
        actual: Math.max(0, (curActual || 0) - (last.actual || 0)),
        plan: Math.max(0, livePlan - (last.plan || 0))
      });
    }
    return segs;
  }
  // 完整日: 第一条快照作为基准点(不构成独立段), 从第二条起差值算每小时产量/目标
  // ★ 2026-08-06 修复: 首条快照是 h8(当天第一小时)时, 基准应为 8:00 整的 0,
  //   而非首条快照值 — 首条快照可能在 08:10 才定格(如抓包空窗), 直接把它的
  //   actual 当基准会吞掉 8:00-8:10 的产量, 与表格 Actual 列对不上
  const isFirstHour = snaps[0].h === 8;
  let prevA = isFirstHour ? 0 : (snaps[0].actual || 0);
  let prevP = isFirstHour ? 0 : (snaps[0].plan || 0);
  let prevH = snaps[0].h;
  for (let i = 1; i < snaps.length; i++) {
    const s = snaps[i];
    if (hourNo(prevH) == null) { prevA = s.actual || 0; prevP = s.plan || 0; prevH = s.h; continue; } // ★ 午休段跳过
    segs.push({
      h: s.h, lab: prevH, live: false,
      actual: Math.max(0, (s.actual || 0) - prevA),
      plan: Math.max(0, (s.plan || 0) - prevP)
    });
    prevA = s.actual || 0; prevP = s.plan || 0; prevH = s.h;
  }
  // ★ 完整日也有当前进行中的小时段
  if (curActual != null && prevH <= nowH && nowH - prevH < 2 && hourNo(prevH) != null) {
    segs.push({
      h: nowH, lab: prevH, live: true,
      actual: Math.max(0, (curActual || 0) - prevA),
      plan: Math.max(0, livePlan - prevP)
    });
  }
  return segs;
}
// ---- 目标柱分段(回退/关闭分段时用): 每段目标 = plan ÷ 已过时段数(均匀相等), 柱顶累计 = plan ----
function planSegsOf(name, nowH) {
  const ln = state.lines.find(x => x.name === name) || {};
  const plan = ln.plan || 0; // 实时累计目标(与表格 Plan 列一致)
  let n = 0;
  for (let h = 8; h <= nowH && h <= 16; h++) {
    if (h === 12) continue;
    n++;
  }
  if (!n) return [];
  const per = plan / n;
  const segs = [];
  for (let h = 8; h <= nowH && h <= 16; h++) {
    if (h === 12) continue;
    segs.push({ h: h, lab: h, live: (h === nowH), actual: per });
  }
  return segs;
}
// ---- 固定小时目标(回退用): 日目标 ÷ 8 个工作小时, 每段等高不变 ----
function planSegs(target, nowH) {
  const perH = (target || 0) / 8; // 8 个工作小时(8-9,9-10,10-11,11-12,午休,13-14,14-15,15-16,16-17)
  const segs = [];
  for (let h = 8; h <= nowH && h <= 16; h++) {
    if (h === 12) continue; // 午休不计数
    segs.push({ actual: perH, live: false, lab: h });
  }
  return segs;
}
// ★ v5.15 统一绘制: 两柱共用同一份 segs, 段骨架按目标值(plan)定位 → 段边界完全平行
//   实际柱(key='actual'): 每段 = 蓝色(实际达成, 从段底向上) + 灰色(未达成缺口)
//   目标柱(key='plan'): 每段 = 橙色(目标达成, 画满整段)
//   ★ 两柱段边界线 y 位置相同(都由 plan 累计决定) → 完全平行, 逐段对比 = 蓝 vs 橙 + 灰缺口
function drawStacked(ctx, cx, bw, segs, total, maxV, ch, padT, color, key) {
  // ★ 柱顶 = plan 累计高度(两柱同 y, 数字统一标在柱顶上方)
  const planTotalPix = segs.reduce((s, x) => s + (x.plan || 0), 0) / maxV * ch;
  const topY = padT + ch - planTotalPix;
  const totalH = Math.max(0, (total || 0) / maxV * ch);
  if (!segs.length) {
    // 无分段数据: 纯色累计柱
    const base = padT + ch - totalH;
    ctx.fillStyle = color;
    ctx.fillRect(cx, base, bw, totalH);
  } else {
    let yAcc = padT + ch;
    segs.forEach((s, idx) => {
      const perH = Math.max(0, ((s.plan || 0) / maxV) * ch); // 段高 = 该时段目标(统一骨架)
      yAcc -= perH;
      if (perH < 0.5) return;
      // ★ 灰色底 = 未达成缺口(目标 - 实际), 整段先铺灰
      ctx.fillStyle = "#30363d";
      ctx.fillRect(cx, yAcc, bw, perH);
      // ★ 实际值(蓝)从段底往上画; 目标值(橙)画满整段
      const v = key === "plan" ? (s.plan || 0) : Math.min(s.actual || 0, s.plan || 0);
      const vPix = Math.max(0, (v / maxV) * ch);
      if (vPix > 0.5) {
        ctx.fillStyle = color;
        ctx.fillRect(cx, yAcc + perH - vPix, bw, vPix);
      }
      // ★ 分割线: 段边界(plan 定位) → 两柱完全平行; 柱顶也画收尾线
      ctx.fillStyle = "#0d1117";
      ctx.fillRect(cx - 1, yAcc, bw + 2, 2);
      if (idx === segs.length - 1) {
        ctx.fillRect(cx - 1, yAcc - 2, bw + 2, 2);
      }
      // ★ 段内写数据: 实际柱写实际达成数, 目标柱写该时段目标数
      //   已完成时段: 编号+数值写大一点; 当前小时(live): 数值写小一点(进行中, 未完成)
      ctx.textAlign = "center";
      const valTxt = String(Math.round(v));
      const hNo = hourNo(s.lab);
      // ★ 字体随段高自适应: 段越矮字越小, 避免第8段后文字放不下
      const fBig = perH >= 26 ? 10 : perH >= 20 ? 9 : perH >= 15 ? 8 : perH >= 11 ? 7.5 : 7;
      const fSml = Math.max(6.5, fBig - 1);
      if (s.base) {
        // 上午累计段: 灰底 + "上午"标签 + 数值
        if (perH >= 14) {
          ctx.fillStyle = "#8b949e"; ctx.font = fSml + "px sans-serif";
          ctx.fillText(t("am"), cx + bw / 2, yAcc + perH / 2 - 3);
          ctx.fillStyle = "#e6edf3"; ctx.font = "bold " + fBig + "px sans-serif";
          ctx.fillText(valTxt, cx + bw / 2, yAcc + perH / 2 + 8);
        } else if (perH >= 8) {
          ctx.fillStyle = "#8b949e"; ctx.font = "bold " + fBig + "px sans-serif";
          ctx.fillText(valTxt, cx + bw / 2, yAcc + perH / 2 + 3);
        }
      } else if (s.live) {
        // ★ 当前小时(进行中): 数值稍微小一点, 编号也小, 不喧宾夺主
        if (perH >= 14 && hNo != null) {
          ctx.fillStyle = "#8b949e"; ctx.font = fSml + "px sans-serif";
          ctx.fillText(String(hNo), cx + bw / 2, yAcc + perH / 2 - 1);
          ctx.fillStyle = "#c9d1d9"; ctx.font = fBig + "px sans-serif";
          ctx.fillText(valTxt, cx + bw / 2, yAcc + perH / 2 + 8);
        } else if (perH >= 8) {
          ctx.fillStyle = "#c9d1d9"; ctx.font = fBig + "px sans-serif";
          ctx.fillText(valTxt, cx + bw / 2, yAcc + perH / 2 + 3);
        }
      } else {
        if (perH >= 16 && hNo != null) {
          // 段高足够: 两行 — 编号 + 数值
          ctx.fillStyle = "#8b949e"; ctx.font = fSml + "px sans-serif";
          ctx.fillText(String(hNo), cx + bw / 2, yAcc + perH / 2 - 1);
          ctx.fillStyle = "#ffffff"; ctx.font = "bold " + fBig + "px sans-serif";
          ctx.fillText(valTxt, cx + bw / 2, yAcc + perH / 2 + 8);
        } else if (perH >= 9) {
          // 段高一般: 只写数值
          ctx.fillStyle = "#ffffff"; ctx.font = "bold " + fBig + "px sans-serif";
          ctx.fillText(valTxt, cx + bw / 2, yAcc + perH / 2 + 3);
        }
      }
    });
  }
  if (totalH > 0) {
    // ★ 柱顶数字统一标在 plan 累计高度上方(两柱同 y), 实际柱写实际累计, 目标柱写目标累计
    ctx.fillStyle = color; ctx.font = "9px sans-serif"; ctx.textAlign = "center";
    ctx.fillText(fmt(total), cx + bw / 2, topY - 14);
  }
}

// ★ 小时产出分段开关: 默认关闭(只显示全天累计)。勾选后实际柱/目标柱共用统一骨架逐段对齐对比
const SEG_KEY = "pdtiii_seg_v1";
let segShow = false;
try { segShow = localStorage.getItem(SEG_KEY) === "1"; } catch (e) { segShow = false; }
